# MariaDB connection (used only by export_image_tables.py on a DB-reachable host)
DB_HOST=localhost
DB_PORT=3306
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=wikicine

# Filesystem layout (used by both scripts)
# CSV_DIR holds one CSV per T_WC_TMDB_*_IMAGE table.
CSV_DIR=./csv

# Destination root on the Windows machine. Mapped drive letter or UNC path.
# Examples: Z:\tmdb   \\nas01\media\tmdb
NAS_ROOT=Z:\tmdb

# SQLite progress DB used by the downloader for resumable runs.
STATE_DB=./state.sqlite

# Remote CSV source (SFTP). Used by download_images.py at startup to pull
# the latest CSVs from the VPS into CSV_DIR before downloading any image.
# Leave SSH_HOST empty (or pass --no-fetch) to skip the fetch and run
# against whatever CSVs are already local.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# Path to the private key (preferred over a password). Accepts ~,
# %USERPROFILE%/$HOME, or a path relative to this script's folder. Only this
# key is offered (no SSH agent, no ~/.ssh/id_* scan).
SSH_KEY=~/.ssh/id_ed25519_ovhpv7
# Passphrase for an encrypted SSH_KEY. Leave empty to be prompted at run time
# (the passphrase then never has to live in the .env).
SSH_KEY_PASSPHRASE=
# Password auth, used only when SSH_KEY is empty.
SSH_PASSWORD=
REMOTE_CSV_DIR=/home/debian/docker/download-images/csv

# SFTP_* are an alternative to the SSH_* block above. If both are set,
# SFTP_* wins. Port, key and passphrase still use SSH_PORT / SSH_KEY /
# SSH_KEY_PASSPHRASE unless you also define SFTP_PORT / SFTP_KEY /
# SFTP_KEY_PASSPHRASE.
SFTP_HOST=
SFTP_LOGIN=
SFTP_KEY=
SFTP_KEY_PASSPHRASE=
SFTP_PASSWORD=

